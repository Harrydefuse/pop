# Copy to .env and source it, or export these directly.
# Nothing here is required — the bot degrades gracefully without both.

# Enables narrative scoring. Without it, narrative scores fall back to neutral
# and the mechanical screens do all the work.
ANTHROPIC_API_KEY=

# The default (https://api.mainnet-beta.solana.com) is public and heavily rate
# limited. Use a provider endpoint before running `watch` for any length of time.
SOLANA_RPC_URL=

# Any config value can be overridden here, e.g.
# MEMEBOT_SAFETY_MIN_LIQUIDITY_USD=25000
# MEMEBOT_SCORING_ENTRY_THRESHOLD=0.7
# MEMEBOT_RISK_POSITION_SIZE_PCT=0.02
# MEMEBOT_LOG_LEVEL=debug

# ── Live trading ─────────────────────────────────────────────────────────────
# All of these are required together, alongside mode:"live" and the arm phrase
# in config.json. Missing any one and the bot runs as paper instead.

# MEMEBOT_LIVE_ARMED=true

# The signing key: base58 (Phantom/Solflare export) or a JSON byte array.
# Prefer execution.keypairPath in config.json with a chmod 600 file.
# SOLANA_PRIVATE_KEY=

# Emergency stop: create bot/data/STOP (or run `node src/cli.js stop`).
